# Copy to .env and fill in values. Do not commit real secrets.

# Main app (contractor PO, etc.)
MONGODB_URI=

# CDC Bills digitization — PurchaseBills collection (separate database or cluster)
MONGODB_URI_Billing=

JWT_SECRET=

# CDC Bills admin accounts (set passwords manually in .env)
CDC_BILLS_ADMIN1_USER=
CDC_BILLS_ADMIN1_PASSWORD=
CDC_BILLS_ADMIN2_USER=
CDC_BILLS_ADMIN2_PASSWORD=

OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# Cloudinary is RETAINED as the rollback target (MIGRATION.md §9). Do not
# remove these until R2 has run clean and the legacy fields are dropped.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2. Set the real values in Render's dashboard, never in a
# committed file. These are server-only — no R2 value may ever be exposed to
# the browser (MIGRATION.md §2.1); the client receives presigned URLs only.
R2_ACCOUNT_ID=
R2_BUCKET=cdc-media

# Read+write — only on services that accept uploads
R2_RW_ACCESS_KEY_ID=
R2_RW_SECRET_ACCESS_KEY=

# Read-only — on services that merely display images
R2_RO_ACCESS_KEY_ID=
R2_RO_SECRET_ACCESS_KEY=

# Public base URL of this API, e.g. https://cdcapi.onrender.com — REQUIRED
# when USE_R2 is on. Job product images are stored as a link back to this API
# so the customer portal (which cannot sign R2 URLs) keeps working unchanged.
PUBLIC_API_BASE_URL=

# Rollback gate (MIGRATION.md §9). "true" serves presigned R2 URLs where an
# r2_key exists; anything else serves the legacy Cloudinary URL.
USE_R2=false

# ---------------------------------------------------------------------------
# WhatsApp Office-Group Monitor
# Off unless WHATSAPP_MONITOR_ENABLED=true, so the backend runs untouched
# without any of the below. See src/whatsapp-monitor/README.md.
# ---------------------------------------------------------------------------
WHATSAPP_MONITOR_ENABLED=false
MONGODB_URI_WA=

MAYTAPI_PRODUCT_ID=
MAYTAPI_PHONE_ID=
MAYTAPI_TOKEN=
MAYTAPI_MESSAGE_COUNT=100
MAYTAPI_MAX_PAGES=5
MAYTAPI_TIMEOUT_MS=45000
MAYTAPI_GROUP_BUDGET_MS=120000

LLM_PROVIDER=openai
LLM_MODEL_FAST=gpt-5-mini
LLM_MODEL_STRONG=gpt-5
LLM_CONTEXT_MESSAGES=15

POLL_CRON=*/5 * * * *
ROLLING_SUMMARY_CRON=0 */4 * * *
DAILY_SUMMARY_TIME=20:00
CURSOR_OVERLAP_SECONDS=60
MESSAGE_TTL_SECONDS=5184000

DEFAULT_OWNER_PHONE=
ADMIN_PHONE=
DEFAULT_COOLDOWN_MIN=30
# Holds back a DM when the same category was alerted this recently. 0 = alert on every concern.
ALERT_COOLDOWN_MIN=30

# How long a concern waits before its first DM, measured from the triggering
# message. Nothing is sent if it is acknowledged, resolved, or the thread says
# it is fixed before the window expires - most problems are handled by the
# people already in the group. Applies to every severity.
ALERT_AFTER_MIN_INTERNAL=30
ALERT_AFTER_MIN_CLIENT=15

# Transcribes WhatsApp voice notes so the tool can read them. This sends staff
# voice recordings to OpenAI - tell the groups before turning it on.
TRANSCRIBE_VOICE=false
# Must be whisper-1: WhatsApp sends Ogg/Opus, and the gpt-4o transcribe models
# reject it outright ("400 Unsupported file format oga").
LLM_MODEL_TRANSCRIBE=whisper-1
TRANSCRIBE_MAX_PER_RUN=20
DEFAULT_ESCALATE_AFTER_MIN=30

DASHBOARD_BASE_URL=
