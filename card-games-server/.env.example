# Copy to .env for local development. On Render/Railway, set these in the dashboard.
PORT=3000

# The client's URL(s), comma-separated. Only these origins may connect.
CLIENT_ORIGIN=http://localhost:5173

# From LiveKit Cloud (https://cloud.livekit.io): Settings -> Keys.
# Leave blank to run without video; the games still work.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
